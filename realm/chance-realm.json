{
  "realm": "chance",
  "displayName": "Chance",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationFlow": "chance registration",
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "Chance",
    "ssl": "${SMTP_SSL}",
    "starttls": "${SMTP_STARTTLS}",
    "auth": "${SMTP_AUTH}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespanLogin": 900,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByUserLifespan": 300,
  "firstBrokerLoginFlow": "chance first broker login",
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 54 },
    { "alias": "TERMS_AND_CONDITIONS", "name": "Terms and Conditions", "providerId": "TERMS_AND_CONDITIONS", "enabled": false, "defaultAction": false, "priority": 20 },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": true, "defaultAction": false, "priority": 40 },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 57 },
    { "alias": "delete_account", "name": "Delete Account", "providerId": "delete_account", "enabled": false, "defaultAction": false, "priority": 60 },
    { "alias": "UPDATE_EMAIL", "name": "Update Email", "providerId": "UPDATE_EMAIL", "enabled": true, "defaultAction": false, "priority": 70 },
    { "alias": "webauthn-register", "name": "Webauthn Register", "providerId": "webauthn-register", "enabled": true, "defaultAction": false, "priority": 80 },
    { "alias": "webauthn-register-passwordless", "name": "Webauthn Register Passwordless", "providerId": "webauthn-register-passwordless", "enabled": true, "defaultAction": false, "priority": 90 },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": true, "defaultAction": false, "priority": 100 },
    { "alias": "delete_credential", "name": "Delete Credential", "providerId": "delete_credential", "enabled": true, "defaultAction": false, "priority": 110 },
    { "alias": "idp_link", "name": "Linking Identity Provider", "providerId": "idp_link", "enabled": true, "defaultAction": false, "priority": 120 },
    { "alias": "CONFIGURE_RECOVERY_AUTHN_CODES", "name": "Recovery Authentication Codes", "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES", "enabled": true, "defaultAction": false, "priority": 130 },
    { "alias": "update_user_locale", "name": "Update User Locale", "providerId": "update_user_locale", "enabled": true, "defaultAction": false, "priority": 1000 }
  ],
  "internationalizationEnabled": false,
  "localizationTexts": {
    "en": {
      "emailUpdateConfirmationBody": "Someone asked to move a {2} account to this address ({1}). Chance does not change addresses by mail, so this mail holds no link. If you did not ask for this, ignore this mail; your own account and address stay as they are. To change your address, ask the Chance support.",
      "emailUpdateConfirmationBodyHtml": "<p>Someone asked to move a {2} account to this address ({1}). Chance does not change addresses by mail, so this mail holds no link.</p><p>If you did not ask for this, ignore this mail; your own account and address stay as they are. To change your address, ask the Chance support.</p>",
      "emailVerificationBody": "Someone has created a {2} account with this email address. If this was you, click the link below to verify your email address and choose your password.\n\n{0}\n\nThis link will expire within {3}.\n\nIf you did not create this account, do not click the link and ignore this mail: without the link nobody can use the account.",
      "emailVerificationBodyHtml": "<p>Someone has created a {2} account with this email address. If this was you, click the link below to verify your email address and choose your password.</p><p><a href=\"{0}\">Link to e-mail address verification</a></p><p>This link will expire within {3}.</p><p>If you did not create this account, do not click the link and ignore this mail: without the link nobody can use the account.</p>"
    }
  },
  "attributes": {
    "CreateDefaultClientScopes": "true",
    "actionTokenGeneratedByUserLifespan.update-email": "1"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{},\"pattern\":{\"pattern\":\"^[^@]+$\",\"error-message\":\"A user name must not contain @ (you sign in with your e-mail address anyway)\"}}},{\"name\":\"email\",\"displayName\":\"${email}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Operator of Chance: creates tenants and their first admin; sees no tenant's trading data"
      },
      {
        "name": "tenant-admin",
        "description": "Retired (token contract v2): the tenant role is the member's group /tenant-admin in the organization; no service reads this realm role. Kept only until the tenants service stops using it"
      },
      {
        "name": "trader",
        "description": "Retired (token contract v2): the tenant role is the member's group /trader in the organization; no service reads this realm role. Kept only until the tenants service stops using it"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "chance-organization",
      "description": "The organization the user signs in to and the member's role there (the groups /tenant-admin or /trader of that organization). Request it as chance-organization:<alias>",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "true",
            "addOrganizationId": "false",
            "addOrganizationAttributes": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "organization groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "addGroupRoleMappings": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "false",
            "userinfo.token.claim": "false",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "web",
      "name": "Chance web app",
      "description": "The single-page web app: authorization code flow with PKCE, no client secret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${CHANCE_WEB_URL}",
      "baseUrl": "/",
      "redirectUris": ["${CHANCE_WEB_URL}/*"],
      "webOrigins": ["${CHANCE_WEB_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CHANCE_WEB_URL}/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles", "chance-organization"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience chance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chance",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tenants",
      "name": "tenants service",
      "description": "Service account of the tenants service: manages organizations, members and their roles",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TENANTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles", "kc-admin-api"],
      "optionalClientScopes": []
    },
    {
      "clientId": "payments",
      "name": "payments service",
      "description": "Service account of the payments service: gets tokens for calls to the other services; no Admin REST API access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PAYMENTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience chance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chance",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "market-maker",
      "name": "market-maker service",
      "description": "Service account of the market-maker service: gets tokens for calls to the trading service's internal API; no Admin REST API access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MARKET_MAKER_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience chance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chance",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "markets",
      "name": "markets service",
      "description": "Service account of the markets service: gets tokens for calls to the trading service's internal API; no Admin REST API access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MARKETS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience chance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chance",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tenants-markets",
      "name": "tenants service, calls to markets",
      "description": "Service account that the tenants service uses only for its calls to the internal admission endpoint of markets: audience chance, no Admin REST API access (the client tenants holds the admin roles and carries no audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TENANTS_MARKETS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience chance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chance",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "chance registration",
      "description": "Sign-up of Chance: the form with the user profile; with verifyEmail on, the password is chosen only after the mail link, by whoever follows it",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "flowAlias": "chance registration form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "chance registration form",
      "description": "The sign-up form: the user profile; the password step gives the new user the required action UPDATE_PASSWORD, which follows the mail link",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 50,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-recaptcha-action",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 60,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-terms-and-conditions",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 70,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "chance first broker login",
      "description": "First login through a provider: a new account for a new address and user name, or the existing account only after its own password; no profile review, no mailed link, no silent link",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "flowAlias": "chance first broker login create or link",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "chance first broker login create or link",
      "description": "A new account for a new address and user name, otherwise the link to the existing one",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "chance first broker login link existing",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "chance first broker login link existing",
      "description": "Account already exists: the person confirms, then signs in with that account's password (Forgot Password? there mails a reset link to the account's address, which replaces any password the account had)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-confirm-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "chance first broker login second factor",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "chance first broker login second factor",
      "description": "The account's one-time code, when it has one",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "chance first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google user name",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "template": "google.${CLAIM.sub}",
        "target": "LOCAL",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-tenants",
      "enabled": true,
      "serviceAccountClientId": "tenants",
      "clientRoles": {
        "realm-management": ["manage-organizations", "manage-users", "view-users", "query-users", "view-realm"]
      }
    },
    {
      "username": "${PLATFORM_ADMIN_USERNAME}",
      "email": "${PLATFORM_ADMIN_EMAIL}",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["platform-admin"],
      "requiredActions": ["UPDATE_PASSWORD"],
      "credentials": [
        {
          "type": "password",
          "value": "${PLATFORM_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ]
}
